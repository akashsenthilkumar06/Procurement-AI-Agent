# Copy to .env and add your key. Setup creates this file for you if needed.
# The app loads .env automatically at startup. Restart after changing it.
# Keep real keys in .env; leave this example blank.
OPENAI_API_KEY=

# Optional local server settings:
# HOST=127.0.0.1
# PORT=8765
# DATA_DIR=./data
# SERVER_SPEND_CAP_USD=5

# Remote Docker deployment: set the domain and independent secrets before launch.
# ADMIN_TOKEN must have at least 32 characters for remote startup.
# STUDY_HOST=study.example.com
# ADMIN_TOKEN=
# INTEGRATION_KEY=
# FRAME_ORIGINS=https://your-survey.example.com
